# ==============================================================================
# BongoNex Environment Variables
# Duplicate this file to .env or .env.local and fill in the values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BASE URLS
# ------------------------------------------------------------------------------
# Base URL for the Next.js app (used by oRPC client, SEO, and newsletter links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Prisma / Supabase)
# ------------------------------------------------------------------------------
# Connection string with pooled connection (e.g. Supabase pooler or direct Postgres)
DATABASE_URL="postgresql://postgres:your-db-password@localhost:5432/bongonex?schema=public"

# Direct connection string for Prisma migrations and shadow DB (Supabase session mode :5432)
DIRECT_URL="postgresql://postgres:your-db-password@localhost:5432/bongonex?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Better Auth & OAuth)
# ------------------------------------------------------------------------------
# Backend auth URL (should match your app URL)
BETTER_AUTH_URL="http://localhost:3000"

# Frontend auth URL (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Secret key for encrypting sessions and tokens (run: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-secret-better-auth-key-min-32-chars"

# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. FILE STORAGE (Supabase Storage)
# ------------------------------------------------------------------------------
# Supabase project URL and anon key for client-side image uploads
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# ------------------------------------------------------------------------------
# 5. KV CACHE & RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Upstash Redis REST API credentials for OTP storage and rate limiting
KV_REST_API_URL="https://your-upstash-instance.upstash.io"
KV_REST_API_TOKEN="your-upstash-rest-token"

# ------------------------------------------------------------------------------
# 6. EMAIL / SMTP (Nodemailer / Google App Password)
# ------------------------------------------------------------------------------
# Gmail address and Google App Password (not your normal Gmail password)
GOOGLE_APP_EMAIL="your-email@gmail.com"
GOOGLE_APP_PASSWORD="your-16-digit-app-password"

# ------------------------------------------------------------------------------
# 7. SMS / PHONE OTP (Twilio - Optional)
# ------------------------------------------------------------------------------
# Used for sending SMS OTP verification codes to customer phones
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# ------------------------------------------------------------------------------
# 8. PUSH NOTIFICATIONS (ntfy.sh - Optional)
# ------------------------------------------------------------------------------
# Topic names on ntfy.sh for real-time order and admin OTP alerts
NTFY_TOPIC="bongonex-orders"
NTFY_OTP_TOPIC="bongonex-otp"
